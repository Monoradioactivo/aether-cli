{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex",
    "npm",
    "github-actions"
  ],
  "branchPrefix": "chore/renovate-",
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^examples/ci/(gitlab-ci\\.yml|Jenkinsfile|circleci-config\\.yml)$"
      ],
      "matchStrings": [
        "AETHER_CLI_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "AETHER_CLI_VERSION = '(?<currentValue>\\d+\\.\\d+\\.\\d+)'",
        "default: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "@aetherpush/cli",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "semanticCommitType": "docs",
      "semanticCommitScope": "ci",
      "automerge": true,
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": [
        "npm",
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dev dependencies (non-major)"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "github actions (non-major)"
    }
  ],
  "timezone": "America/Mexico_City",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true
}
